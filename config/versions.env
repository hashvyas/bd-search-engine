# Pinned versions for the whole team. scripts/01_install.sh compares installed tools with these.
JAVA_MAJOR=11
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.3.4
SPARK_PACKAGE=spark-3.3.4-bin-hadoop3
SCALA_BINARY_VERSION=2.12
# The course guide uses 1.8.1. We pin 1.4.3: it is already on the reference Spark classpath, and a second
# runtime jar would conflict. It supports MERGE INTO, snapshots and the Hadoop catalog on Spark 3.3.
ICEBERG_VERSION=1.4.3
ICEBERG_JAR=iceberg-spark-runtime-3.3_2.12-1.4.3.jar
# Spark 3.3.4 PySpark fails on Python 3.12 (cloudpickle). Every node uses 3.10.
PYTHON_VERSION=3.10
UV_VERSION=0.5.11
ZEROTIER_MIN_VERSION=1.12.0

HADOOP_URL=https://archive.apache.org/dist/hadoop/common/hadoop-3.3.6/hadoop-3.3.6.tar.gz
SPARK_URL=https://archive.apache.org/dist/spark/spark-3.3.4/spark-3.3.4-bin-hadoop3.tgz
ICEBERG_URL=https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.3_2.12/1.4.3/iceberg-spark-runtime-3.3_2.12-1.4.3.jar
UV_URL=https://github.com/astral-sh/uv/releases/download/0.5.11/uv-x86_64-unknown-linux-gnu.tar.gz
