# Copy to config/cluster.env (gitignored) on every node. Use the same values everywhere.
#   cp config/cluster.env.example config/cluster.env

# --- ZeroTier ---
ZT_NETWORK_ID=                 # 16 hex chars from my.zerotier.com
NODE1_IP=                      # ingestion   (ZeroTier IP, e.g. 10.147.17.11)
NODE2_IP=                      # storage     (NameNode, DataNode, Spark worker)
NODE3_IP=                      # compute     (Spark master, worker, DataNode)
NODE4_IP=                      # serving     (FastAPI)

# Linux user on node3 (run `whoami` there; WSL usernames differ). node4 rsyncs the export from it over ssh.
NODE3_USER=
# NODE3_EXPORT_DIR defaults to /home/$NODE3_USER/bigdata/exports. Set it only if node3's BDSE_HOME differs.
#NODE3_EXPORT_DIR=

# Optional shared secret. If set, POST /reload requires header X-Reload-Token (08_pull_and_serve.sh sends it).
RELOAD_TOKEN=

# --- Local paths (per node) ---
BDSE_HOME=$HOME/bigdata        # HDFS dirs, pids, logs, exports, serving, rendered configs
BDSE_VENV=$HOME/.venvs/bdse    # Python 3.10 env created by 01_install.sh

# --- Datasets on node1 (switch to the main corpus for the final run) ---
PHASE0_FILE=data/toy/pages.jsonl
PHASE1_FILE=data/toy/changes.json

# --- Ports ---
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_PORT=9866
HDFS_DATANODE_HTTP_PORT=9864
HDFS_DATANODE_IPC_PORT=9867
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_PORT=7078
SPARK_WORKER_WEBUI_PORT=8081
SPARK_DRIVER_PORT=7079
SPARK_DRIVER_BLOCKMANAGER_PORT=7080
SPARK_BLOCKMANAGER_PORT=7090   # executors
SERVE_PORT=8000

# --- Memory and cores ---
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
SPARK_SHUFFLE_PARTITIONS=8
HDFS_REPLICATION=2

# --- Job tuning ---
PAGERANK_ITERATIONS=20         # minimum 10 is enforced
PAGERANK_CHECKPOINT_EVERY=3
